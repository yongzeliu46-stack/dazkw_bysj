ht w:val="single" w:color="auto" w:sz="12" w:space="0"/></w:tcBorders></w:tcPr><w:p w14:paraId="5869211C"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/></w:rPr><w:t>可行性分析：</w:t></w:r></w:p><w:p w14:paraId="47BB5ECE"><w:pPr><w:ind w:firstLine="181" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>技术可行性</w:t></w:r><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>：本系统功能主要涉及Web开发中的CRUD（增删改查）及文件上传下载操作。本人已掌握Java Web开发基础和Vue前端技术，且Spring Boot与Vue是目前非常成熟的开发组合，技术文档丰富，能够满足开发需求。</w:t></w:r></w:p><w:p w14:paraId="5E780CF3"><w:pPr><w:ind w:firstLine="181" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>经济可行性</w:t></w:r><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>：开发工具（IDEA、VS Code、MySQL等）均为免费或开源软件，无需昂贵的硬件投入，开发成本可控。</w:t></w:r></w:p><w:p w14:paraId="569CED8A"><w:pPr><w:ind w:firstLine="181" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>操作可行性</w:t></w:r><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>：系统界面设计简洁直观（参考现有的HTML设计），符合学生和家长的使用习惯。分类清晰的导航和筛选功能使得用户能快速找到所需资料，易用性强。</w:t></w:r></w:p><w:p w14:paraId="63D1DC6F"><w:pPr><w:ind w:firstLine="181" w:firstLineChars="100"/><w:rPr><w:rFonts w:hint="eastAsia" w:ascii="宋体" w:hAnsi="宋体" w:eastAsia="宋体" w:cs="宋体"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>社会可行性</w:t></w:r><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>：项目紧扣“中考备考”这一社会热点，不仅服务于学生提分，也促进了教育公平，具有良好的社会效益和推广前景。</w:t></w:r></w:p></w:tc></w:tr><w:tr w14:paraId="1A70C3A3"><w:tblPrEx><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:left w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:bottom w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:right w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:insideH w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:insideV w:val="single" w:color="auto" w:sz="4" w:space="0"/></w:tblBorders><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPrEx><w:trPr><w:trHeight w:val="3172" w:hRule="atLeast"/><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="9390" w:type="dxa"/><w:gridSpan w:val="7"/><w:tcBorders><w:top w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:left w:val="single" w:color="auto" w:sz="12" w:space="0"/><w:bottom w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:right w:val="single" w:color="auto" w:sz="12" w:space="0"/></w:tcBorders></w:tcPr><w:p w14:paraId="78BE5CA3"><w:pPr><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:sz w:val="24"/></w:rPr><w:t>预期进展：</w:t></w:r></w:p><w:p w14:paraId="510D74C7"><w:pPr><w:ind w:firstLine="180" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>第1-2周： 完善选题背景调研，确定系统功能边界，完成开题报告。</w:t></w:r></w:p><w:p w14:paraId="1F625695"><w:pPr><w:ind w:firstLine="180" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>第3-4周： 数据库设计（设计视频表、资料表、教师表等），搭建Spring Boot后端开发环境。</w:t></w:r></w:p><w:p w14:paraId="6DDE338E"><w:pPr><w:ind w:firstLine="180" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>第5-8周： 完成后端核心接口开发（文件上传下载接口、视频列表查询接口、资讯发布接口）。</w:t></w:r></w:p><w:p w14:paraId="432C301E"><w:pPr><w:ind w:firstLine="180" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>第9-12周： 基于现有的HTML模板进行Vue前端组件化改造，实现前后端数据交互与页面渲染。</w:t></w:r></w:p><w:p w14:paraId="6712867A"><w:pPr><w:ind w:firstLine="180" w:firstLineChars="100"/><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>第13-14周： 系统集成测试，修复Bug，优化UI细节（如倒计时逻辑、筛选响应速度）。</w:t></w:r></w:p><w:p w14:paraId="029EA01A"><w:pPr><w:ind w:firstLine="180" w:firstLineChars="100"/><w:rPr><w:rFonts w:hint="eastAsia"/><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr></w:pPr><w:r><w:rPr><w:kern w:val="0"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>第15-16周： 撰写毕业论文，准备答辩演示材料。</w:t></w:r></w:p></w:tc></w:tr><w:tr w14:paraId="40707D94"><w:tblPrEx><w:tblBorders><w:top w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:left w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:bottom w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:right w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:insideH w:val="single" w:color="auto" w:sz="4" w:space="0"/><w:insideV w:val="single" w:color="auto" w:sz="4" w:space="0"/></w:tblBorders><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPrEx><w:trPr><w:trHeight w:val="2622" w:hRule="atLeast"/><w:jc w:val="center"/></w:trPr><w:tc><w:tcPr><w:tcW w:w="9390" w:type="dxa"/><w:gridSpan w:val="7"/><w:tcBorders><w:top w:val="single" w:color="auto" w:sz="4" w:space="